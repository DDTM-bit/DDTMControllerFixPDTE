<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<PublishAot>true</PublishAot>
	<RuntimeIdentifier>win-x86</RuntimeIdentifier>
	<NativeLib>Shared</NativeLib>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinHook.NET" Version="1.1.2" />
    <PackageReference Include="ppy.SDL2-CS" Version="1.0.741-alpha" />
	  <!-- Mouse cursor picture (one square master, e.g. 64 x 64), built into the dll. Replace it and rebuild to change the cursor. -->
	  <EmbeddedResource Include="resources\cursor.png" LogicalName="cursor.png" />
  </ItemGroup>

</Project>
