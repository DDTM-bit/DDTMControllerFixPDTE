<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<PublishAot>true</PublishAot>
	<RuntimeIdentifier>win-x86</RuntimeIdentifier>
	<NativeLib>Shared</NativeLib>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinHook.NET" Version="1.1.2" />
    <PackageReference Include="ppy.SDL2-CS" Version="1.0.741-alpha" />
	  <!-- Mouse cursor pictures, built into the dll. Replace a file and rebuild to change the cursor. -->
	  <EmbeddedResource Include="resources\cursor_1080p.png" LogicalName="cursor_1080p.png" />
	  <EmbeddedResource Include="resources\cursor_1440p.png" LogicalName="cursor_1440p.png" />
	  <EmbeddedResource Include="resources\cursor_2160p.png" LogicalName="cursor_2160p.png" />
  </ItemGroup>

</Project>
